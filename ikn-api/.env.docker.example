# Salin ke .env.docker (dev) atau ke folder deploy produksi. Nilai rahasia TIDAK pernah di-commit.
APP_NAME="PT IKN API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
FRONTEND_URL=https://www.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ikn
DB_USERNAME=ikn
DB_PASSWORD=
# dipakai image postgres (harus sama dengan DB_*)
POSTGRES_DB=ikn
POSTGRES_USER=ikn
POSTGRES_PASSWORD=

CACHE_DRIVER=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=www.example.com,example.com
CORS_ALLOWED_ORIGINS=https://www.example.com,https://example.com

# SMTP relay port 587 (Brevo/Mailgun/Postmark), bukan kirim langsung dari VPS (KEPUTUSAN)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="PT Industri Karet Nusantara"

# Payment gateway (kerangka Xendit; kosong = non-aktif)
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Geocoding proxy
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="IKN-Web/1.0 (+https://www.example.com; it@example.com)"

# Seeder produksi minimal (dijalankan sekali)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# Compose produksi
SITE_DOMAIN=www.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=it@example.com
IKN_API_TAG=latest
IKN_FE_TAG=latest
RUN_MIGRATIONS=false
PHP_PM_MAX_CHILDREN=12
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_MAX_CONNECTIONS=60
