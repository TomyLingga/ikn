APP_NAME="IKN API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

# URL frontend Next.js (untuk tautan di email dan CORS)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Domain FE yang boleh memakai sesi cookie Sanctum (SPA)
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:8000,127.0.0.1:8000
# Produksi: SESSION_DOMAIN=.example.com dan SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ecom
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@ikn.local
MAIL_FROM_NAME="${APP_NAME}"

# Akun super admin awal untuk seeder (dev saja; ganti di produksi)
SEED_SUPER_ADMIN_EMAIL=superadmin@ptikn.com
SEED_SUPER_ADMIN_PASSWORD=password

# Antrean & email: dev = sync + log; produksi = database + SMTP relay 587 (jalankan queue:work)
# Payment gateway (kerangka Xendit; kosong = driver gateway non-aktif)
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Geocoding proxy (Nominatim/OSM, wajib User-Agent jelas)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="IKN-Web/1.0 (+https://<domain>; it@<domain>)"
