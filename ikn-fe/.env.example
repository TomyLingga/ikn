# URL API yang dipakai browser (build-time). Dev: http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# URL API yang dipakai fetch sisi server Next.js (runtime). Dev: http://127.0.0.1:8000/api/v1
API_INTERNAL_URL=http://127.0.0.1:8000/api/v1


# Detik jawaban API konten dianggap segar di cache server Next (bawaan 30; 0 = tanpa cache).
# Aksi tulis admin mengosongkan cache seketika; lihat lib/server-data.ts.
# CONTENT_CACHE_TTL=30
