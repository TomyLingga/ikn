# =============================================================================
# KONFIGURASI SUPABASE DATABASE (FRONTEND STANDALONE)
# =============================================================================
# Dapatkan Project URL dan Anon Public Key di https://app.supabase.com
# Project Settings -> API -> Project URL & Project API Keys (anon public)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# (Opsional) Jika di masa depan ingin mengaktifkan backend Laravel kembali:
# USE_BACKEND=false
# API_ORIGIN=http://localhost:8000
